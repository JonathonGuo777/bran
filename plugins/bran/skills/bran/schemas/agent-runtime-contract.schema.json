{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JonathonGuo777/bran/schemas/agent-runtime-contract.schema.json",
  "title": "Bran Character Agent Runtime Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "projectId", "packageVersion", "contracts"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "1.0.0" },
    "projectId": { "type": "string", "minLength": 1 },
    "packageVersion": { "type": "string", "minLength": 1 },
    "contracts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "agentId",
          "role",
          "goal",
          "knowledgeFactIds",
          "refusalBoundary",
          "toolAllowlist",
          "actionAllowlist",
          "memoryAccess",
          "responseSchema"
        ],
        "properties": {
          "agentId": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "minLength": 1 },
          "goal": { "type": "string", "minLength": 1 },
          "knowledgeFactIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "refusalBoundary": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "toolAllowlist": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "actionAllowlist": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "memoryAccess": {
            "type": "object",
            "additionalProperties": false,
            "required": ["readScopes", "writeMode"],
            "properties": {
              "readScopes": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
              "writeMode": { "enum": ["none", "candidate-only"] }
            }
          },
          "responseSchema": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true }
        }
      }
    }
  }
}
