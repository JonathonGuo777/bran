{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JonathonGuo777/bran/schemas/source-event.schema.json",
  "title": "Bran Source Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "order",
    "title",
    "summary",
    "sourceSpans",
    "participants",
    "action",
    "result",
    "causeEventIds",
    "canonStatus",
    "confidence"
  ],
  "properties": {
    "eventId": { "type": "string", "minLength": 1 },
    "order": { "type": "integer", "minimum": 0 },
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "sourceSpans": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sourceId", "locator"],
        "properties": {
          "sourceId": { "type": "string", "minLength": 1 },
          "locator": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": ["string", "integer", "number"]
            }
          },
          "quoteHash": { "type": "string" }
        }
      }
    },
    "participants": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "action": { "type": "string", "minLength": 1 },
    "result": { "type": "string", "minLength": 1 },
    "causeEventIds": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "time": { "type": ["string", "null"] },
    "locationId": { "type": ["string", "null"] },
    "canonStatus": {
      "enum": ["source-confirmed", "grounded-inference", "adaptation", "unresolved"]
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "reviewStatus": {
      "enum": ["provisional", "accepted", "rejected"],
      "default": "provisional"
    },
    "notes": { "type": "string" }
  }
}
