{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JonathonGuo777/bran/schemas/bran-input-bundle.schema.json",
  "title": "Bran Input Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "project",
    "sources",
    "sourceEvents",
    "canonFacts",
    "characters",
    "stateModel",
    "scenes",
    "recipes",
    "settlement",
    "agents",
    "runtime",
    "productionHandoff",
    "review"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "1.0.0" },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectId", "title", "language", "packageVersion", "runtimeTarget"],
      "properties": {
        "projectId": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "language": { "type": "string", "minLength": 2 },
        "packageVersion": { "type": "string", "minLength": 1 },
        "runtimeTarget": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "compiledAt": { "type": "string", "format": "date-time" }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sourceId", "path", "version", "rights"],
        "properties": {
          "sourceId": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "contentHash": { "type": "string" },
          "rights": { "type": "string", "minLength": 1 },
          "quotePolicy": { "type": "string" }
        }
      }
    },
    "sourceEvents": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "source-event.schema.json" }
    },
    "canonFacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["factId", "statement", "sourceEventIds", "visibility", "status"],
        "properties": {
          "factId": { "type": "string", "minLength": 1 },
          "statement": { "type": "string", "minLength": 1 },
          "sourceEventIds": { "type": "array", "items": { "type": "string" } },
          "visibility": { "type": "array", "items": { "type": "string" } },
          "status": { "enum": ["source-confirmed", "grounded-inference", "adaptation"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "characters": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "stateModel": {
      "type": "object",
      "required": ["fields", "derivedFields"],
      "properties": {
        "fields": { "type": "array", "items": { "type": "object" } },
        "derivedFields": { "type": "array", "items": { "type": "object" } },
        "invariants": { "type": "array", "items": { "type": "string" } }
      }
    },
    "scenes": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "recipes": { "type": "array", "items": { "type": "object" } },
    "settlement": {
      "type": "object",
      "required": ["rules", "testVectors"],
      "properties": {
        "rules": { "type": "array", "minItems": 1, "items": { "type": "object" } },
        "testVectors": { "type": "array", "minItems": 1, "items": { "type": "object" } },
        "projectionContract": { "type": "object" }
      }
    },
    "agents": { "type": "object" },
    "runtime": { "type": "object" },
    "productionHandoff": {
      "type": "object",
      "required": ["assetSlots"],
      "properties": {
        "assetSlots": { "type": "array", "items": { "type": "object" } }
      }
    },
    "review": {
      "type": "object",
      "required": ["status", "entries"],
      "properties": {
        "status": { "enum": ["draft", "in-review", "approved", "locked"] },
        "entries": { "type": "array", "items": { "type": "object" } }
      }
    },
    "auditProfile": { "type": "object" },
    "lineage": { "type": "object" }
  }
}
